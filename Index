<script>
document.addEventListener("DOMContentLoaded", function () {
  const STORAGE_KEY = "b2_base_master_v3";
  const boxes = Array.from(document.querySelectorAll('input[type="checkbox"]'));

  function getSaved() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch (e) {
      return {};
    }
  }

  function saveState() {
    const state = {};
    boxes.forEach((box, index) => {
      state[index] = box.checked;
    });
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {}
  }

  function updateProgress() {
    const total = boxes.length;
    const done = boxes.reduce((count, box) => count + (box.checked ? 1 : 0), 0);
    const pct = total === 0 ? 0 : (done / total) * 100;
    const rounded = Math.round(pct);

    const percentEl = document.getElementById("percent");
    const counterEl = document.getElementById("counter");
    const barEl = document.getElementById("bar");

    if (percentEl) percentEl.textContent = rounded + "%";
    if (counterEl) counterEl.textContent = done + " / " + total + " completed";
    if (barEl) {
      barEl.style.width = pct + "%";
      barEl.setAttribute("aria-valuenow", String(rounded));
    }

    boxes.forEach(box => {
      const item = box.closest(".item");
      if (item) item.classList.toggle("done", box.checked);
    });

    document.querySelectorAll("section[data-section]").forEach(section => {
      const sectionBoxes = Array.from(section.querySelectorAll('input[type="checkbox"]'));
      const sectionDone = sectionBoxes.filter(box => box.checked).length;
      const progress = section.querySelector(".progress");
      if (progress) progress.textContent = sectionDone + " / " + sectionBoxes.length;
    });
  }

  function loadState() {
    const saved = getSaved();
    boxes.forEach((box, index) => {
      box.checked = saved[index] === true;
    });
    updateProgress();
  }

  boxes.forEach(box => {
    box.addEventListener("change", function () {
      saveState();
      updateProgress();
    });
  });

  window.filterItems = function () {
    const q = document.getElementById("search").value.trim().toLowerCase();
    document.querySelectorAll(".item").forEach(item => {
      item.classList.toggle("hide", q !== "" && !item.innerText.toLowerCase().includes(q));
    });
  };

  window.setVisible = function (value) {
    boxes.forEach(box => {
      const item = box.closest(".item");
      if (item && !item.classList.contains("hide")) box.checked = value;
    });
    saveState();
    updateProgress();
  };

  window.resetAll = function () {
    if (confirm("Reset all checklist progress?")) {
      boxes.forEach(box => box.checked = false);
      saveState();
      updateProgress();
    }
  };

  loadState();
});
</script>
