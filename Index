.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(315px,1fr));gap:2px 15px}
.item{display:flex;gap:8px;padding:7px 5px;border-radius:7px;cursor:pointer}.item:hover{background:var(--card2)}.item input{width:17px;height:17px;accent-color:var(--accent);margin-top:2px;flex:none}
.item.done span{text-decoration:line-through;color:#707680}.note{color:var(--muted);font-size:12px;border-left:3px solid var(--accent);padding:7px 9px;margin-bottom:8px}
.hide{display:none!important}.reference li{margin:5px 0;color:#c5c9d0;font-size:13px}
footer{color:#707680;font-size:12px;padding:20px 0}
@media(max-width:600px){.container{padding:10px}h1{font-size:24px}.grid{grid-template-columns:1fr}}
