.stats{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.badge{padding:5px 9px;background:var(--card);border:1px solid var(--line);border-radius:99px;font-size:12px}
.toolbar{position:sticky;top:0;z-index:20;background:rgba(13,15,19,.95);backdrop-filter:blur(10px);padding:10px 0;display:flex;gap:7px;flex-wrap:wrap}
button,input[type=search]{border:1px solid var(--line);border-radius:8px;background:var(--card2);color:var(--text);padding:9px 11px}input[type=search]{flex:1;min-width:230px}button{cursor:pointer}
